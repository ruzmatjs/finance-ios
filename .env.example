# Telegram Bot sozlamalari namunasi (Haqiqiy qiymatlarni .env fayliga yozing)
# .env git'ga tushmaydi (.gitignore'da)

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Shaxsiy chat ID: botga /start yozing, so'ng
# https://api.telegram.org/bot<TOKEN>/getUpdates -> message.chat.id
TELEGRAM_CHAT_ID=your_chat_id_here

# Mini App manzili (GitHub Pages)
MINIAPP_URL=https://ruzmatjs.github.io/finance-ios/
